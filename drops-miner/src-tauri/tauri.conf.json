{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drops Miner",
  "version": "1.0.0",
  "identifier": "com.jbolton.dropsminer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Drops Miner",
        "width": 1220,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0e0e10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.jtvnw.net https://*.twitch.tv; font-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Mines Twitch drops in the background",
    "copyright": "MIT licensed. Based on TwitchDropsMiner by DevilXD.",
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "signCommand": null
    }
  }
}
